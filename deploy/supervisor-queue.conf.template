[program:eprism-queue]
process_name=%(program_name)s_%(process_num)02d
command=php __APP_DIR__/artisan queue:work database --sleep=3 --tries=3 --max-time=3600
directory=__APP_DIR__
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
numprocs=2
redirect_stderr=true
stdout_logfile=__APP_DIR__/storage/logs/queue-worker.log
stopwaitsecs=3600
