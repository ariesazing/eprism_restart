APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Reject registrations whose email domain has no mail server (live DNS lookup).
MAIL_VERIFY_DELIVERABILITY=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

LANGUAGETOOL_URL=
LANGUAGETOOL_LANGUAGE=en-US

ONLYOFFICE_ENABLED=false
ONLYOFFICE_URL=
ONLYOFFICE_JWT_SECRET=
# Only needed when Document Server can't reach this app at APP_URL (e.g. DS running in a
# local Docker container, where APP_URL's "localhost" means the container itself).
ONLYOFFICE_CALLBACK_BASE_URL=
# Only needed if `qpdf` isn't resolvable via PATH for whatever process runs this app (e.g. a
# Windows dev PATH change that hasn't reached the still-running terminal/IDE yet) — set to the
# full path to qpdf's executable as a workaround. Leave empty to just rely on PATH (what the
# production Docker image's apt-installed qpdf already lands on).
QPDF_BINARY=

# Similarity checker (see config/similarity.php): searches the web for passages copied from other
# sources, through a self-hosted SearXNG — no API key, no per-query fee. Start it with:
#   docker compose -f docker-compose.searxng.yml up -d
# Needs a queue worker (`composer dev` runs one). Left empty, the web isn't searched and the
# report says so.
SEARXNG_URL=
# Search language: "all" (default) suits manuscripts mixing English and Filipino; or e.g. en-US.
# SEARXNG_LANGUAGE=all
# Turn the web search off entirely (default true).
# SIMILARITY_WEB_ENABLED=true

VITE_ONLYOFFICE_URL="${ONLYOFFICE_URL}"
VITE_APP_NAME="${APP_NAME}"

# Python virtual environment for manuscript validation and final PDF encryption.
# Windows example: C:/projects/eprism_restart/.venv/Scripts/python.exe
MANUSCRIPT_PYTHON=
DB_QUEUE_RETRY_AFTER=900
REDIS_QUEUE_RETRY_AFTER=900
